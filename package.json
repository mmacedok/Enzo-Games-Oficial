{
  "name": "enzo-games-oficial",
  "version": "1.0.0",
  "description": "Leitor de gibis automatizado",
  "main": "server.js",
  "scripts": {
    "start": "concurrently \"node watch.js\" \"node server.js\"",
    "serve": "node server.js",
    "build": "node atualizar.js",
    "build:deploy": "node atualizar.js && node tools/dist.js && node tools/build-function.mjs",
    "test": "node --test \"test/*.test.js\"",
    "qa": "node tools/qa.mjs",
    "qa:site": "node tools/qa-all.mjs",
    "build:cloudflare": "node atualizar.js && node tools/dist.js && node tools/build-cloudflare.mjs"
  },
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "esbuild": "^0.28.2",
    "jose": "^6.2.12"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@neondatabase/serverless": "^1.1.0",
    "@netlify/database": "^2.0.1",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "sharp": "^0.35.4"
  },
  "overrides": {
    "waddler": {
      "@electric-sql/pglite": "$@electric-sql/pglite"
    }
  }
}
