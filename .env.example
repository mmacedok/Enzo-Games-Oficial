# Copie para .env (fora do git) e preencha. O server.js lê este arquivo ao iniciar.
PORT=3000
NODE_ENV=development

# Google Cloud Console > Credenciais > ID do cliente OAuth (Aplicativo da Web).
# Origens JavaScript autorizadas: http://localhost:3000 e o domínio do site.
GOOGLE_CLIENT_ID="xxxxxx.apps.googleusercontent.com"

# Chave aleatória (>= 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Só em produção (Netlify DB cria sozinho): NETLIFY_DATABASE_URL=postgres://...

# E-mails Google (separados por vírgula) que abrem o painel admin.html.
ADMIN_EMAILS=""
